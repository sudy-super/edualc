{
  "name": "edualc",
  "private": true,
  "type": "module",
  "scripts": {
    "install:local": "python3 scripts/install-local.py",
    "update:sdk": "python3 scripts/update-sdk.py",
    "start": "./bin/edualc",
    "start:direct": "./bin/edualc-direct",
    "test": "bun test && python3 test/extract.test.py && python3 test/extract-full.test.py && python3 test/auth.test.py && python3 test/update-sdk.test.py && python3 scripts/verify-source.py",
    "test:tui": "uv run --no-project scripts/verify-tui.py",
    "extract": "python3 scripts/extract-full.py",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.302"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
